# ==============================================
# DATABASE (Required — Phase 1+)
# ==============================================

# Supabase PostgreSQL connection string (pooled — used for runtime queries)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase PostgreSQL direct connection (not pooled — used for Prisma migrations only)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ==============================================
# APPLICATION (Required — Phase 1+)
# ==============================================

# Full URL where the app is hosted. Used for server-to-server requests.
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================
# AI (Required — Phase 3+)
# ==============================================

# Anthropic Claude API key. DO NOT expose this to the client.
# Never prefix with NEXT_PUBLIC_
# ANTHROPIC_API_KEY="sk-ant-api03-..."

# ==============================================
# SECURITY (Required — Phase 2+)
# ==============================================

# Secret for Vercel Cron job authentication.
# Generate: openssl rand -hex 32
# CRON_SECRET=""

# ==============================================
# FUTURE (Do not configure yet)
# ==============================================

# UPSTASH_REDIS_URL=          # Rate limiting (Phase 3)
# UPSTASH_REDIS_TOKEN=        # Rate limiting (Phase 3)
